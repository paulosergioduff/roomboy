programa "DocScriptLacos" {
    funcao inicio {
        inteiro i = 0

        enquanto i < 3 {
            escreval i
            i = i + 1
        }

        para inteiro j = 0; j < 3; j++ {
            se j = 1 {
                continue
            }
            escreval "j=", j
        }

        faca {
            i = i - 1
            se i = 1 {
                pare
            }
        } enquanto i > 0

        escreval "fim ", i
    }
}
