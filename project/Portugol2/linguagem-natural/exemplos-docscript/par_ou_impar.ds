programa "ParOuImpar" {
    funcao inicio {
        inteiro numero

        escreva "Digite um numero inteiro: "
        leia numero

        (O resto da divisao por dois indica se o numero e par.)
        se numero % 2 = 0 {
            escreval "Par"
        } senao {
            escreval "Impar"
        }
    }
}
