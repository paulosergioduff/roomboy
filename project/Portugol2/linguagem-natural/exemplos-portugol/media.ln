programa "Media" {
    funcao inicio {
        (Declara as duas notas e a media calculada.)
        real nota1
        real nota2
        real media

        escreva "Primeira nota: "
        leia nota1
        escreva "Segunda nota: "
        leia nota2

        (A expressao usa a soma das metades porque agrupamento ainda nao e suportado.)
        media = nota1 / 2.0 + nota2 / 2.0
        escreval "Media: ", media
    }
}
